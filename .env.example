POSTGRES_USER=support_app
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=support_agent

# Used only when running the app directly on the host (not via docker compose) --
# must be kept in sync with the POSTGRES_* values above (different host/port,
# same user/password/db). The dockerized app builds its own DATABASE_URL from
# POSTGRES_* directly, see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://support_app:dev_password_change_me@localhost:5439/support_agent
OPENAI_API_KEY=sk-replace-with-your-real-key
LLM_MODEL=gpt-4o-mini
APP_ENV=development
APP_NAME=customer-support-agent
